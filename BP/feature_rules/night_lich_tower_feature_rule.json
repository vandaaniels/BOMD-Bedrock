          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "frozen"
          }
        ]
      }
    },
    "distribution": {
      "iterations": 1,
      "scatter_chance": 0.0001,
      "coordinate_eval_order": "xzy",
      "x": {
        "distribution": "uniform",
        "extent": [0, 15]
      },
      "y": "query.heightmap(variable.worldx, variable.worldz)",
      "z": {
        "distribution": "uniform",
        "extent": [0, 15]
      }
    }
  }
}
