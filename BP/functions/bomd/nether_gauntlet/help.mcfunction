tellraw @s {"rawtext":[{"text":"§4§lBOMD 2.1.10 — Nether Gauntlet§r"}]}
tellraw @s {"rawtext":[{"text":"§7Locator: use §f/function bomd/nether_gauntlet/locate§7 in the Nether. It follows Java's 32/16-chunk spacing and materializes the arena at Y 15 when approached."}]}
tellraw @s {"rawtext":[{"text":"§7Original arena: §f/function bomd/nether_gauntlet/build_arena§7. Break one of the five central seals."}]}
tellraw @s {"rawtext":[{"text":"§7Direct summon: §f/function bomd/nether_gauntlet/spawn§7. Its eye starts closed, and only the exposed frontal eye accepts damage."}]}
tellraw @s {"rawtext":[{"text":"§7Java attack cycle: punch, energized spin punch, delayed-target laser, and blindness below 50 percent health."}]}
tellraw @s {"rawtext":[{"text":"§7Reward: chest with a Blazing Eye, five Ancient Debris veins, and 1000 XP."}]}
