  "bomd_lich_boss_node": {
    "type": "image",
    "size": [7, 7],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "texture": "textures/ui/bomd/lich_boss_bar_dividers",
    "uv_size": [7, 7],
    "bilinear": false,
    "layer": 4
  },

  "bomd_lich_boss_node_active@hud.bomd_lich_boss_node": {
    "uv": [45, 0],
    "visible": false,
    "layer": 5,
    "$node_visible_binding|default": "(#progress_percentage > 0.25 or #progress_percentage = 0.25)",
    "bindings": [
      {
        "binding_name": "$node_visible_binding",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars",
        "binding_condition": "always"
      }
    ]
  },

  "bomd_lich_boss_node_inactive@hud.bomd_lich_boss_node": {
    "uv": [45, 7]
  },

