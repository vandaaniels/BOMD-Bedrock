{
  "format_version": "1.26.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "bomd:lich_phantom",
      "materials": {
        "default": "phantom",
        "invisible": "phantom_invisible"
      },
      "textures": {
        "default": "textures/entity/phantom"
      },
      "geometry": {
        "default": "geometry.bomd_night_lich.lich_phantom"
      },
      "scripts": {
        "scale": "1.3",
        "pre_animation": [
          "variable.wingRotZ = 16.0 * math.sin((variable.RuntimeID * 3 + query.life_time * 20.0) * 7.448454);",
          "variable.tailRotX = -5.0 * math.sin((variable.RuntimeID * 3 + query.life_time * 20.0) * 14.896908) - 5.0;"
        ],
        "initialize": [
          "variable.runtimeid = 0;",
          "variable.tailrotx = -5.0;",
          "variable.wingrotz = 0.0;"
        ],
        "animate": [
          "phantom_base_pose_controller",
          "move_controller"
        ],
        "should_update_effects_offscreen": "1.0"
      },
      "animations": {
        "phantom_base_pose": "animation.bomd_night_lich.lich_phantom_base_pose",
        "move": "animation.bomd_night_lich.lich_phantom_move",
        "phantom_base_pose_controller": "controller.animation.bomd_night_lich.lich_phantom_base_pose",
        "move_controller": "controller.animation.bomd_night_lich.lich_phantom_move"
      },
      "particle_effects": {
        "wing_dust": "minecraft:phantom_trail_particle"
      },
      "render_controllers": [
        "controller.render.bomd_night_lich.lich_phantom"
      ],
      "spawn_egg": {
        "texture": "spawn_egg_phantom"
      }
    }
  }
}
