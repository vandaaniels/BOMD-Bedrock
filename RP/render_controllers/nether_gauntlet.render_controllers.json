{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.bomd_nether_gauntlet": {
      "arrays": {
        "textures": {
          "Array.base": [
            "Texture.default",
            "Texture.hurt"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.base[query.property('bomd:gauntlet_hurt')]"
      ],
      "uv_anim": {
        "offset": [0, 0],
        "scale": [1, 1]
      }
    },
    "controller.render.bomd_nether_gauntlet_emissive": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.emissive"
        }
      ],
      "textures": ["Texture.emissive"],
      "color": {
        "r": 1,
        "g": 0.2,
        "b": 0.06,
        "a": "0.18 + query.property('bomd:gauntlet_energy') * 0.36"
      },
      "uv_anim": {
        "offset": [0, 0],
        "scale": [1, 1]
      }
    },
    "controller.render.bomd_nether_gauntlet_energy": {
      "geometry": "Geometry.default",
      "part_visibility": [
        {
          "codeRoot": "query.property('bomd:gauntlet_energy') > 0"
        }
      ],
      "materials": [
        {
          "*": "Material.emissive"
        }
      ],
      "textures": ["Texture.energy"],
      "color": {
        "r": 1,
        "g": 0.08,
        "b": 0.02,
        "a": "query.property('bomd:gauntlet_energy') == 2 ? 0.7 : (query.property('bomd:gauntlet_energy') == 1 ? 0.32 : 0)"
      },
      "uv_anim": {
        "offset": [
          "query.life_time * 0.18",
          "query.life_time * 0.18"
        ],
        "scale": [1, 1]
      }
    }
  }
}
