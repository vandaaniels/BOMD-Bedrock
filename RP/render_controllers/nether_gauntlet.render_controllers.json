{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.bomd_nether_gauntlet": {
      "arrays": {
        "textures": {
          "Array.visual": [
            "Texture.normal",
            "Texture.charging",
            "Texture.overcharged"
          ]
        },
        "materials": {
          "Array.visual": [
            "Material.default",
            "Material.fullbright",
            "Material.fullbright"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Array.visual[q.property('bomd:visual_state')]"
        }
      ],
      "textures": [
        "q.hurt_time > 0.0 ? Texture.hurt : Array.visual[q.property('bomd:visual_state')]"
      ],
      "uv_anim": {
        "offset": [
          0,
          0
        ],
        "scale": [
          1,
          1
        ]
      }
    }
  }
}
